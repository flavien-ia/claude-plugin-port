{
  "name": "claude-plugin-port",
  "version": "0.4.0",
  "description": "The engine behind claude-plugin-to-codex and claude-plugin-to-opencode: ports a Claude Code plugin to OpenAI Codex or to OpenCode (manifest translation, skills with rewritten path anchors and host-valid names, PreToolUse hooks carried over, MCP servers, rules files, portable bundles with a self-contained installer). Library API plus a generic command.",
  "type": "module",
  "bin": {
    "claude-plugin-port": "bin/claude-plugin-port.mjs"
  },
  "files": [
    "bin",
    "lib"
  ],
  "scripts": {
    "test": "node --test test/converter.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "codex",
    "openai-codex",
    "opencode",
    "plugin",
    "skills",
    "agent-skills",
    "SKILL.md",
    "AGENTS.md",
    "hooks",
    "converter",
    "migration"
  ],
  "license": "MIT",
  "author": "Flavien Chervet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flavien-ia/claude-plugin-port.git"
  },
  "bugs": {
    "url": "https://github.com/flavien-ia/claude-plugin-port/issues"
  },
  "homepage": "https://github.com/flavien-ia/claude-plugin-port#readme",
  "main": "./lib/convert.mjs",
  "exports": {
    ".": {
      "types": "./lib/convert.d.ts",
      "default": "./lib/convert.mjs"
    },
    "./convert": {
      "types": "./lib/convert.d.ts",
      "default": "./lib/convert.mjs"
    },
    "./bundle": {
      "types": "./lib/bundle.d.ts",
      "default": "./lib/bundle.mjs"
    },
    "./guard": {
      "types": "./lib/guard.d.ts",
      "default": "./lib/guard.mjs"
    },
    "./cli": {
      "types": "./lib/cli.d.ts",
      "default": "./lib/cli.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./lib/convert.d.ts"
}
